# These version tags are starting pins; validate both images together and record
# their immutable digests in the release checklist before VM provisioning.
TRACCAR_IMAGE=traccar/traccar:6.16.0
MYSQL_IMAGE=mysql:8.4
TRACCAR_PROXY_IMAGE=nginx:1.30.5-alpine3.24

# Replace with unique generated values before starting Compose.
MYSQL_DATABASE=traccar
MYSQL_USER=traccar
MYSQL_PASSWORD=REPLACE_WITH_GENERATED_SECRET
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_GENERATED_SECRET

# Standard ST-901 is listed as H02/TCP 5013; ST-901 A+ is JT808/TCP 5015.
# Confirm the exact model and protocol from the device/supplier before opening this.
TRACCAR_DEVICE_PORT=5013

# Required only for the private-api Compose profile. Must be the VM's private IP,
# and the TLS certificate must be trusted by the Cloud Run API container.
TRACCAR_VM_PRIVATE_IP=127.0.0.1
