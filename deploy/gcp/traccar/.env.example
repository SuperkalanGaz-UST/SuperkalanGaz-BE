# Resolved Linux AMD64 manifest pins; retest before changing any image.
TRACCAR_IMAGE=traccar/traccar:6.16.0@sha256:a32a4e0a0656a3fc9ba0b23e9e741be2fab76d85c5208b6adfeef7ab473979e8
MYSQL_IMAGE=mysql:8.4@sha256:80f4933e3835f9dc4d35a28ec500d7986cb4414e6c6821c5461239cb7beb8995
TRACCAR_PROXY_IMAGE=nginx:1.30.5-alpine3.24@sha256:8f84ed99befc3891b8f329c5c202785278a2cfb7c25107d57fb2a134a3117433

# Replace with unique generated values before starting Compose.
MYSQL_DATABASE=traccar
MYSQL_USER=traccar
MYSQL_PASSWORD=REPLACE_WITH_GENERATED_SECRET
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_GENERATED_SECRET

# This release enables ONLY H02, for the confirmed standard ST-901.
# ST-901 A+ needs JT808 and a separately tested configuration, not just a port change.
TRACCAR_DEVICE_PORT=5013

# Required only for the private-api Compose profile. Must be the VM's private IP,
# and the TLS certificate must be trusted by the Cloud Run API container.
TRACCAR_VM_PRIVATE_IP=10.60.0.10
TRACCAR_DEVICE_BIND_IP=0.0.0.0
# Leaf certificate must have subjectAltName IP:10.60.0.10; NestJS must trust
# its private CA. Main deployment workflow supplies these protected files.
TRACCAR_TLS_CERT_FILE=./certs/traccar-api.crt
TRACCAR_TLS_KEY_FILE=./certs/traccar-api.key
