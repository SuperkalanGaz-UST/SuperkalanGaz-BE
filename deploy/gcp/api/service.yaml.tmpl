apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: superkalan-crm-api
  labels:
    cloud.googleapis.com/location: asia-southeast1
  annotations:
    run.googleapis.com/launch-stage: BETA
    run.googleapis.com/description: Superkalan Gaz NestJS API behind an NGINX ingress sidecar
    run.googleapis.com/ingress: all
    run.googleapis.com/invoker-iam-disabled: "true"
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/minScale: "0"
        autoscaling.knative.dev/maxScale: "2"
        run.googleapis.com/cpu-throttling: "true"
        # Fractional NGINX CPU requires gen1 and single-request concurrency.
        run.googleapis.com/execution-environment: gen1
        run.googleapis.com/vpc-access-egress: private-ranges-only
        run.googleapis.com/network-interfaces: '__VPC_NETWORKS_JSON__'
        run.googleapis.com/container-dependencies: '{"nginx":["api"]}'
    spec:
      serviceAccountName: __RUNTIME_SERVICE_ACCOUNT__
      containerConcurrency: 1
      timeoutSeconds: 60
      containers:
        - name: nginx
          image: __NGINX_IMAGE__
          ports:
            - name: http1
              containerPort: 8080
          resources:
            limits:
              cpu: 500m
              memory: 256Mi
          # Check the proxy and its upstream, not merely an open NGINX socket.
          startupProbe:
            httpGet:
              path: /api/health/ready
              port: 8080
            timeoutSeconds: 10
            periodSeconds: 10
            failureThreshold: 24
        - name: api
          image: __API_IMAGE__
          env:
            - name: NODE_ENV
              value: production
            - name: PORT
              value: "3001"
            - name: WEB_ORIGIN
              value: __WEB_ORIGIN__
            - name: SUPABASE_URL
              value: __SUPABASE_URL__
            - name: SUPABASE_PUBLISHABLE_KEY
              value: __SUPABASE_PUBLISHABLE_KEY__
            - name: SUPABASE_SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: __SUPABASE_SECRET_KEY_SECRET__
                  key: __SUPABASE_SECRET_KEY_SECRET_VERSION__
__OPTIONAL_SECRET_ENV__
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: __DATABASE_SECRET__
                  key: __DATABASE_SECRET_VERSION__
            - name: DATABASE_SSL
              value: "true"
            - name: DATABASE_SSL_REJECT_UNAUTHORIZED
              value: "true"
            - name: DATABASE_SSL_CA_CERT_PATH
              value: /var/run/secrets/supabase/root.crt
            - name: DATABASE_RESOLVE_POOLER_IPV4
              value: "false"
            - name: SUPABASE_STORAGE_BUCKET
              value: delivery-proofs
            - name: DELIVERY_RIDER_MOBILE_VERIFICATION_MODE
              value: sms
          resources:
            limits:
              cpu: "1"
              memory: 1Gi
          startupProbe:
            httpGet:
              path: /api/health/ready
              port: 3001
            timeoutSeconds: 10
            periodSeconds: 10
            failureThreshold: 24
          livenessProbe:
            httpGet:
              path: /api/health/live
              port: 3001
            timeoutSeconds: 5
            periodSeconds: 30
            failureThreshold: 3
          volumeMounts:
            - name: supabase-db-ca
              mountPath: /var/run/secrets/supabase
              readOnly: true
__OPTIONAL_CA_MOUNT__
      volumes:
        - name: supabase-db-ca
          secret:
            secretName: __SUPABASE_DB_CA_SECRET__
            items:
              - key: __SUPABASE_DB_CA_SECRET_VERSION__
                path: root.crt
                # CA certificates are public trust material; USER node must read
                # this root-owned multi-container secret mount (0444 decimal).
                mode: 292
__OPTIONAL_CA_VOLUME__
