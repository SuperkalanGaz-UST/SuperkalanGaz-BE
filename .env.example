# App
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed web-dashboard origins (CORS).
WEB_ORIGIN=http://localhost:3000
# Keep this aligned with Supabase Auth's Email OTP Expiration setting so the
# lifecycle feed reports the same expiry enforced by the invitation link.
SUPABASE_EMAIL_OTP_EXPIRY_SECONDS=3600
# Local development uses the custom scheme below. For production, use the HTTPS
# invitation page on the verified App Link / Universal Link host, for example:
# https://<APP_LINK_HOST>/delivery-rider-invitation
# Add a path-scoped Supabase Auth redirect rule that permits the server-appended
# token query, for example https://<APP_LINK_HOST>/delivery-rider-invitation**.
DELIVERY_RIDER_INVITATION_REDIRECT_URL=superkalan://delivery-rider-invitation
DELIVERY_RIDER_INVITATION_EXPIRY_HOURS=48
# Temporary development bridge while the SMS sender is awaiting approval.
# Set to sms after approval. The API permits placeholder mode only when
# NODE_ENV is explicitly development or test.
DELIVERY_RIDER_MOBILE_VERIFICATION_MODE=placeholder

# Database — Supabase used as managed Postgres ONLY (standard connection + TypeORM).
# Do NOT use the Supabase client SDK or PostgREST (bypasses the branch-scoped JWT guards).
# Dashboard → Connect → Direct connection / Session pooler, e.g.:
#   postgresql://postgres:[PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=
# Local-only compatibility switch for networks where Supavisor TLS stalls when
# the pooler hostname is sent as SNI. Keep false unless that exact issue occurs.
DATABASE_RESOLVE_POOLER_IPV4=false

# Supabase Auth — used to VERIFY caller JWTs (via the project's JWKS endpoint)
# and to administer identities through the GoTrue Admin REST API.
SUPABASE_URL=
# Optional public Auth key used server-side for signup/resend requests. This is
# the same publishable/anon key used by the mobile Auth client and is preferred
# for least privilege. The server-only service key is the compatibility fallback.
SUPABASE_ANON_KEY=
# service_role key (Dashboard → Project Settings → API). Server-only secret.
SUPABASE_SERVICE_ROLE_KEY=
# Temporary private object-storage bucket for Proof of Delivery images. The
# NestJS API is the only component allowed to access this bucket.
SUPABASE_STORAGE_BUCKET=delivery-proofs
# Only needed for legacy projects that still sign JWTs with the shared HS256
# secret. Leave empty to verify against the JWKS endpoint (asymmetric keys).
SUPABASE_JWT_SECRET=

# One-time bootstrap only: npm run seed:super-admin. Keep real values uncommitted.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
# Optional canonical PH E.164 value, e.g. +639171234567.
SUPER_ADMIN_PHONE=

# Traccar GPS middleware — server-side only. The web and mobile clients must
# never receive these values or call Traccar directly.
# Use http://localhost:8082 when Traccar and NestJS run on the same PC. When
# NestJS runs on another machine on the trusted LAN, use the Traccar PC's
# reserved LAN IPv4 address, for example http://192.168.1.50:8082.
TRACCAR_BASE_URL=http://localhost:8082
# Generate this token for the dedicated CRM integration account in Traccar.
# Store the real value only in .env or the production host's secret manager.
TRACCAR_TOKEN=
# Bounded polling and request timeout values in milliseconds.
TRACCAR_POLL_INTERVAL_MS=15000
TRACCAR_TIMEOUT_MS=5000
# One retry after the first failed request. Keep bounded to avoid tying up API requests.
TRACCAR_RETRY_LIMIT=1

# PayMongo Hosted Checkout — CU-017 is test-mode only. Leave all values empty
# when the integration is disabled. The API refuses non-test secret keys.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Public HTTPS origin of this NestJS API, without a trailing slash. PayMongo
# uses it for webhook registration and hosted-checkout success/cancel returns.
PAYMONGO_PUBLIC_BASE_URL=
PAYMONGO_REQUEST_TIMEOUT_MS=5000
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300
